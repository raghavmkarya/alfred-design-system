    {
      "id": "console-hero",
      "global": "LibConsoleHero",
      "file": "library/sections/fusion.js",
      "name": "Console hero",
      "tier": 1,
      "description": "The terminal absorption executed on-brand: split hero with a Kbd-built keyboard hint on the left and a console evidence pane on the right, where Alfred works in prompt-prefixed mono lines under a phosphor-glow live dot. 12px-radius card, hairline border, blinking cursor. No window chrome, no scanlines, no green.",
      "pageTypes": [
        "landing",
        "feature"
      ],
      "usedBy": [],
      "props": [
        {
          "name": "eyebrow",
          "type": "string"
        },
        {
          "name": "title",
          "type": "string"
        },
        {
          "name": "titleAccent",
          "type": "string",
          "doc": "substring of title rendered in the brand gradient; the section's one gradient element"
        },
        {
          "name": "sub",
          "type": "string"
        },
        {
          "name": "primaryCta",
          "type": "string"
        },
        {
          "name": "secondaryCta",
          "type": "string"
        },
        {
          "name": "hintKey",
          "type": "string",
          "doc": "the key cap inside the Kbd hint line"
        },
        {
          "name": "hintAfter",
          "type": "string",
          "doc": "hint text after the key cap"
        },
        {
          "name": "connected",
          "type": "string[]",
          "doc": "sources on the live connection line; null = the variant's default"
        },
        {
          "name": "transcript",
          "type": "Array<{verb, text}>",
          "doc": "prompt-prefixed work lines; verbs checked/traced/flagged carry the orange/periwinkle semantics; null = the variant's default"
        },
        {
          "name": "readyLine",
          "type": "string",
          "doc": "the closing brief-ready line the cursor blinks after; null = the variant's default"
        },
        {
          "name": "variant",
          "type": "'default' | 'briefing'"
        }
      ],
      "variants": [
        {
          "id": "default",
          "name": "Working session",
          "props": {}
        },
        {
          "id": "briefing",
          "name": "Briefing transcript",
          "props": {
            "variant": "briefing"
          }
        }
      ]
    },
